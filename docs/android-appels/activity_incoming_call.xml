<?xml version="1.0" encoding="utf-8"?>
<!-- À placer dans app/src/main/res/layout/activity_incoming_call.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/call_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_background"
    android:clipChildren="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="0dp"
    android:paddingEnd="24dp"
    android:paddingBottom="44dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="168dp"
        android:layout_height="168dp"
        android:clipChildren="false">

        <!-- Nappe de lumière : 430dp centrée sur l'avatar, déborde du cadre, non cliquable.
             alpha 0.34 = opacité au centre ; le dégradé s'éteint à 66 % du rayon. -->
        <View
            android:layout_width="430dp"
            android:layout_height="430dp"
            android:layout_gravity="center"
            android:alpha="0.34"
            android:background="@drawable/call_halo"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <!-- Appelant connu : initiales -->
        <TextView
            android:id="@+id/call_initials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/call_circle_teal"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/call_foreground"
            android:textSize="54sp"
            android:textStyle="bold" />

        <!-- Appelant inconnu : silhouette, contour siège -->
        <FrameLayout
            android:id="@+id/call_unknown"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/call_avatar_unknown"
            android:visibility="gone">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_call_person" />
        </FrameLayout>

        <ImageView
            android:id="@+id/call_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/call_circle_teal"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/call_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:ellipsize="end"
        android:gravity="center"
        android:letterSpacing="-0.02"
        android:maxLines="2"
        android:textColor="@color/call_foreground"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/call_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:textColor="@color/call_secondary"
        android:textSize="15sp" />

    <!-- Masquée (GONE) si la charge utile ne porte pas le tour -->
    <TextView
        android:id="@+id/call_turn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:textColor="@color/call_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:gravity="bottom|center"
        android:orientation="horizontal">

        <LinearLayout style="@style/CallBtnColumn">
            <ImageButton
                android:id="@+id/btn_decline"
                style="@style/CallBtnSecondary"
                android:background="@drawable/call_circle_red"
                android:contentDescription="Refuser"
                android:rotation="135"
                android:src="@drawable/ic_call_phone"
                android:tint="@color/call_decline_foreground" />
            <TextView style="@style/CallBtnLabel" android:text="Refuser" />
        </LinearLayout>

        <LinearLayout
            style="@style/CallBtnColumn"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="34dp">

            <FrameLayout
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:clipChildren="false">

                <!-- Anneaux de respiration, plus grands que le bouton, dessinés hors cadre -->
                <View
                    android:id="@+id/accept_ring_2"
                    android:layout_width="138dp"
                    android:layout_height="138dp"
                    android:layout_gravity="center"
                    android:background="@drawable/call_ring_2" />
                <View
                    android:id="@+id/accept_ring_1"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_gravity="center"
                    android:background="@drawable/call_ring_1" />

                <ImageButton
                    android:id="@+id/btn_accept"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:background="@drawable/call_circle_green"
                    android:contentDescription="Décrocher"
                    android:padding="26dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_call_phone"
                    android:tint="@color/call_accept_foreground" />
            </FrameLayout>

            <TextView
                style="@style/CallBtnLabel"
                android:text="Décrocher"
                android:textColor="@color/call_foreground"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout style="@style/CallBtnColumn">
            <ImageButton
                android:id="@+id/btn_message"
                style="@style/CallBtnSecondary"
                android:background="@drawable/call_circle_message"
                android:contentDescription="Message"
                android:src="@drawable/ic_call_message" />
            <TextView style="@style/CallBtnLabel" android:text="Message" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
