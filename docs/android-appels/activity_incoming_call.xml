<?xml version="1.0" encoding="utf-8"?>
<!-- À placer dans app/src/main/res/layout/activity_incoming_call.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B2E30"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="96dp"
    android:paddingBottom="48dp">

    <TextView
        android:id="@+id/call_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="24dp"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/call_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#B8D4D5"
        android:textSize="16sp" />

    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="72dp">

        <TextView
            android:id="@+id/call_initials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/call_circle_teal"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="56sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/call_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/call_circle_teal"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout style="@style/CallBtnColumn">
            <ImageButton
                android:id="@+id/btn_decline"
                style="@style/CallBtn"
                android:background="@drawable/call_circle_red"
                android:contentDescription="Refuser"
                android:rotation="135"
                android:src="@android:drawable/sym_action_call" />
            <TextView style="@style/CallBtnLabel" android:text="Refuser" />
        </LinearLayout>

        <LinearLayout style="@style/CallBtnColumn">
            <ImageButton
                android:id="@+id/btn_accept"
                style="@style/CallBtn"
                android:background="@drawable/call_circle_green"
                android:contentDescription="Décrocher"
                android:src="@android:drawable/sym_action_call" />
            <TextView style="@style/CallBtnLabel" android:text="Décrocher" />
        </LinearLayout>

        <LinearLayout style="@style/CallBtnColumn">
            <ImageButton
                android:id="@+id/btn_message"
                style="@style/CallBtn"
                android:background="@drawable/call_circle_grey"
                android:contentDescription="Message"
                android:src="@android:drawable/sym_action_chat" />
            <TextView style="@style/CallBtnLabel" android:text="Message" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
