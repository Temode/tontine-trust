<?xml version="1.0" encoding="utf-8"?>
<!-- Rôles typographiques repris de tailwind.config : title 24 / 1.25 / 700, body 16 / 1.55. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/call_circle_teal"
        android:contentDescription="@null"
        android:padding="18.5dp"
        android:src="@drawable/ic_call_phone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Recevoir les appels de votre tontine"
        android:textColor="@color/app_foreground"
        android:textSize="24sp"
        android:textStyle="bold"
        android:lineSpacingMultiplier="1.25"
        android:letterSpacing="-0.015" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Pour que les appels s'affichent même lorsque votre téléphone est verrouillé, autorisez l'affichage plein écran."
        android:textColor="@color/app_muted_foreground"
        android:textSize="16sp"
        android:lineSpacingMultiplier="1.55" />

    <Button
        android:id="@+id/fsi_allow"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/app_button_primary"
        android:stateListAnimator="@null"
        android:text="Autoriser l'affichage plein écran"
        android:textAllCaps="false"
        android:textColor="@color/call_foreground"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fsi_later"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:text="Plus tard"
        android:textColor="@color/app_muted_foreground"
        android:textSize="16sp" />
</LinearLayout>
